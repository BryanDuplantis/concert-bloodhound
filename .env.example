# Ticketmaster Discovery API key.
# 1. Sign up free at https://developer.ticketmaster.com/
# 2. Create an app, copy its "Consumer Key".
# 3. Copy this file to ".env" and paste the key below.
# The .env file is gitignored — the key never enters version control.
TICKETMASTER_API_KEY=your_consumer_key_here

# JamBase Data API key (covers touring + independent venues + free festivals).
# Free Developer tier (1,000 calls/month, non-commercial): sign up at
# https://data.jambase.com/ — create an app, copy the key. Sent as a Bearer token.
JAMBASE_API_KEY=your_jambase_key_here
