# concert-bloodhound — remote MCP server (HTTP transport, OAuth-gated).
# SYSTEM unit, mirrors brain-mcp.service minus the docker dependency (no
# ChromaDB here). Funnel 443 /bloodhound → http://127.0.0.1:3003/bloodhound
# fronts it publicly; the server binds 127.0.0.1 only, so that is its sole ingress.
#
# Install (from ~/concert-bloodhound on the Pi):
#   sudo cp deploy/concert-bloodhound.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now concert-bloodhound.service
[Unit]
Description=concert-bloodhound MCP Server (remote HTTP)
After=network.target

[Service]
Type=simple
User=brydup
WorkingDirectory=/home/brydup/concert-bloodhound
EnvironmentFile=/home/brydup/concert-bloodhound/.env.local
ExecStart=/usr/bin/node dist/index.js --transport http
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
